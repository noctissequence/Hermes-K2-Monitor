COLLAB_DIR=/root/hermes-monitor/collab
K2_BIND_HOST=127.0.0.1
K2_HTTP_PORT=8766
K2_PUNCH_UDP_PORT=0
COLLAB_LOCAL_NODE_ID=k2-host-node
# DIISI setelah join ke node temen (arah Bos->temen):
COLLAB_LOCAL_NODE_TOKEN=
# DIISI dengan relay URL node temen (arah Bos->temen):
COLLAB_PARTNER_URLS=
# MESH_KEY dibaca dari collab/.auth/mesh_key (bukan env) — jangan ditaruh sini
